# --- LLM keys: set any subset. Providers without a key are skipped. ---
# Order and models: config/llm.json, or change at runtime with PUT /llm
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI only: bill a specific org / project. Use separate projects (and keys) for
# staging and production, each with its own spend and rate limits.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- required ---

# --- storage: JSON files (default ./data); sources + profiles in ./config ---
# DATA_DIR=data
# CONFIG_DIR=config
RETENTION_DAYS=30

# --- LLM limits ---
LLM_TIMEOUT_S=60
LLM_RATE_LIMIT=30/m
DAILY_TOKEN_BUDGET=400000
ENRICH_MAX_ITEMS_PER_RUN=40

# --- schedule / digest ---
REDIS_URL=redis://localhost:6379/0
TIMEZONE=Asia/Kolkata
DAILY_RUN_HOUR=7
LOOKBACK_HOURS=36
DIGEST_TOP_N=8
# where people open the app; used for links in digests and emails
# (docker compose publishes it on 8081, a local uvicorn on 8000)
PUBLIC_BASE_URL=http://localhost:8081

# --- email (Mailtrap sandbox works well for demos) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=AI Pulse <pulse@example.com>
DIGEST_RECIPIENTS=team@example.com
